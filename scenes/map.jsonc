    "padding": 0.02,
    "fill_mode": true,
    "ensure_connected": true,
    "greedy_merge": true,
    "ke": 1e6,
    "kd": 1e3,
  },

  "solver": {
    "rigid_body_contact_buffer_size": 16384,
