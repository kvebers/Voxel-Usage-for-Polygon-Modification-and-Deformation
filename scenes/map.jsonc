    "far": 200.0,
  },

  "simulation": {
    "fps": 60,
    "substeps": 4,
    "start_paused": true,
  },

  "ground": {
    "position": [0.0, 0.0, -0.5],
    "half_extents": [50.0, 50.0, 0.5],
    "density": 0.0,
