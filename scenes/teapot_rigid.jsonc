{
  "objects": [
    {
      "path": "obj/teapot.obj",
      "offset": [0, 0.0, 2.0],
      "color": [0.9, 0.5, 0.2],
      "resolution": 4,
    },
  ],

  "camera": {
    "position": [-4.0, -3.0, 2.0],
    "target": [0.0, 0.0, 1.2],
    "fov": 50,
    "near": 0.1,
    "far": 200.0,
  },

  "window": {
    "width": 1280,
    "height": 720,
    "title": "Augmented Greedy Vertex Voxel Block Descent",
    "clear_color": [0.08, 0.09, 0.12, 1.0],
  },

  "simulation": {
    "fps": 60,
    "substeps": 1,
    "start_paused": true,
  },

  "ground": {
    "position": [0.0, 0.0, -0.5],
    "half_extents": [50.0, 50.0, 0.5],
    "density": 0.0,
    "ke": 5e5,
    "kd": 2e3,
    "kf": 1e3,
    "mu": 0.9,
  },

  "voxels": {
    "density": 600.0,
    "padding": 0.02,
    "fill_mode": true,
  },

  "ball": {
    "enabled": true,
    "count": 1,
    "radius_factor": 0.2,
    "height_factor": 5.0,
    "density": 1000.0,
    "ke": 2e3,
    "kd": 1e3,
    "kf": 1e3,
    "mu": 0.5,
    "color": [0.3, 0.35, 0.85],
  },

  "solver": {
    "rigid_body_contact_buffer_size": 8192,
    "rigid_contact_k_start": 1e4,
    "rigid_joint_linear_ke": 1e3,
    "rigid_joint_angular_ke": 1e3,
    "rigid_avbd_beta": 5e2,
    "iterations": 8,
    "rigid_joint_linear_kd": 500.0,
    "rigid_joint_angular_kd": 500.0,
  },

  "joints": {
    "enabled": true,
    "linear_break_force": 3500.0,
    "angular_break_torque": 4500.0,
    "damage_rate": 0.3,
    "heal_rate": 0.1,
    "instant_break_force": 1e8,
    "instant_break_torque": 1e8,
    "max_breaks_per_step": 2,
  },

  "render": {
    "default_mode": "mesh",
    "mesh_color": [0.7, 0.95, 0.2],
  },

  "force_modes": {
    "strength": 100.0,
  },

  "mesh_splitter": {
    "base_rot": [

      [1, 0, 0],
      [0, 0, -1],
      [0, 1, 0],
    ],
    "base_offset": [0.0, 0.0, 1.8],
    "deform_method": "rigid",
  },
}
